<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\GlyphStash.Presentation\GlyphStash.Presentation.csproj" />
    <ProjectReference Include="..\GlyphStash.Application\GlyphStash.Application.csproj" />
    <ProjectReference Include="..\GlyphStash.Infrastructure\GlyphStash.Infrastructure.csproj" />
    <ProjectReference Include="..\GlyphStash.Platform.Windows\GlyphStash.Platform.Windows.csproj" />
    <ProjectReference Include="..\GlyphStash.Localization\GlyphStash.Localization.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <ApplicationIcon>Assets\glyphstash.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <GlyphStashFontToolsWorkerPath>$(MSBuildProjectDirectory)\..\..\tools\fonttools-worker\dist\glyphstash-fonttools-worker.exe</GlyphStashFontToolsWorkerPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <Content Include="$(GlyphStashFontToolsWorkerPath)" Condition="Exists('$(GlyphStashFontToolsWorkerPath)')">
      <TargetPath>glyphstash-fonttools-worker.exe</TargetPath>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="ValidateFontToolsWorkerForNativeAot" BeforeTargets="ComputeFilesToPublish" Condition="'$(PublishAot)' == 'true'">
    <Error Condition="!Exists('$(GlyphStashFontToolsWorkerPath)')" Text="NativeAOT publish requires tools\fonttools-worker\dist\glyphstash-fonttools-worker.exe. Run tools\fonttools-worker\build.ps1 before publishing." />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

</Project>
