<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GlyphStash.Desktop.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GlyphStash.Presentation/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#118169" />
        <ColorPaletteResources x:Key="Dark" Accent="#46C2A0" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://GlyphStash.Presentation/Styles/Components.axaml" />
  </Application.Styles>
</Application>
