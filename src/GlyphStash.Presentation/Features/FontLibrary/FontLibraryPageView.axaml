<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feature="using:GlyphStash.Presentation.Features.FontLibrary"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:views="using:GlyphStash.Presentation.Views"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.FontLibraryPageView"
             x:DataType="feature:FontLibraryViewModel">
  <Grid x:Name="FontLibraryRoot" RowDefinitions="76,*,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource GlyphSurfaceBrush}"
            BorderBrush="{DynamicResource GlyphBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{DynamicResource L.Text.788523AA1322815D}" Classes="h1" />
          <TextBlock Text="{Binding ScanStatus}" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <Button Content="{DynamicResource L.Text.DAF5103F90CC7D3A}" Command="{Binding RescanCommand}" />
          <Button Content="{DynamicResource L.Text.50751AA95894C7DB}" Classes="primary" Command="{Binding OpenImportDialogCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="LibraryContentGrid" Grid.Row="1" ColumnDefinitions="250,*,360" ColumnSpacing="16" Margin="{StaticResource GlyphPagePadding}">
      <Border x:Name="LibraryFiltersPanel" Grid.Column="0" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <ScrollViewer>
          <StackPanel Spacing="14">
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource L.Text.2664F501D6FC3031}" Classes="caption" FontWeight="Bold" />
              <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource L.Text.B90B82579B690EEE}" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource L.Text.A488E93D69CC1296}" Classes="caption" FontWeight="Bold" />
              <ComboBox ItemsSource="{Binding SourceFilterOptions}"
                        SelectedItem="{Binding SelectedSourceFilterOption, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalizedOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource L.Text.83DE9A9A34438B31}" Classes="caption" FontWeight="Bold" />
              <ComboBox ItemsSource="{Binding StateFilterOptions}"
                        SelectedItem="{Binding SelectedStateFilterOption, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalizedOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource L.Text.1D0FD5F9336D9103}" Classes="caption" FontWeight="Bold" />
              <ComboBox ItemsSource="{Binding TagFilterOptions}"
                        SelectedItem="{Binding SelectedTagFilterOption, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalizedOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Text="{DynamicResource L.Text.528E5174C2D4E5C8}" Classes="caption" FontWeight="Bold" />
              <ComboBox ItemsSource="{Binding CollectionFilterOptions}"
                        SelectedItem="{Binding SelectedCollectionFilterOption, Mode=TwoWay}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LocalizedOptionViewModel">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <Button Content="{DynamicResource L.Text.2FD867CEA5B82DEA}" Command="{Binding OpenTagsDialogCommand}" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid x:Name="LibraryResultsColumn" Grid.Column="1" RowDefinitions="*,Auto" RowSpacing="16">
      <Border x:Name="LibraryListPanel" Grid.Row="0" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.Text.DB96383CD775A45D}" Classes="h2" />
              <TextBlock Text="{DynamicResource L.Text.6FF5AAFFF2F0F470}" Classes="muted" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Content="{DynamicResource L.Text.30714325CFB2B97D}" Classes="sm" Command="{Binding SetPreviewModeCommand}" CommandParameter="单行" />
              <Button Content="{DynamicResource L.Text.7679497CDE353BCF}" Classes="sm" Command="{Binding SetPreviewModeCommand}" CommandParameter="段落" />
              <Button Content="{DynamicResource L.Text.1E61CD479C3866E9}" Classes="sm" Command="{Binding SetPreviewModeCommand}" CommandParameter="字符集" />
            </StackPanel>
          </Grid>

          <Grid Grid.Row="1">
            <TextBlock Text="{DynamicResource L.Text.F567A39EB2D7F558}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />

            <Border BorderBrush="{DynamicResource GlyphBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource GlyphRadiusLg}"
                    Padding="22"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IsVisible="{Binding IsEmpty}">
              <StackPanel HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="{Binding EmptyStateMessage}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <Button Content="{DynamicResource L.Text.0F276D4CFBF1E3BA}" Command="{Binding RescanCommand}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>

            <ListBox Classes="font-list"
                     ItemsSource="{Binding Fonts}"
                     SelectedItem="{Binding SelectedFont, Mode=TwoWay}"
                     IsVisible="{Binding HasFonts}">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FontFamilyItemViewModel">
                  <Border Classes="card" Margin="0,0,0,10">
                    <StackPanel Spacing="9">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                          <TextBlock Text="{Binding FamilyName}" Classes="h2" />
                          <WrapPanel Margin="0,7,0,0">
                            <Border Classes="badge" Classes.ok="{Binding IsOkState}" Classes.warn="{Binding IsWarningState}" Margin="0,0,7,0">
                              <TextBlock Text="{Binding StateLabel}" FontSize="12" />
                            </Border>
                            <Border Classes="badge" Classes.blue="{Binding IsSystemSource}" Margin="0,0,7,0">
                              <TextBlock Text="{Binding SourceLabel}" FontSize="12" />
                            </Border>
                            <Border Classes="badge" Margin="0,0,7,0">
                              <TextBlock Text="{Binding StyleCountLabel}" FontSize="12" />
                            </Border>
                          </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                          <Button Classes="ghost sm"
                                  Content="{Binding TemporaryActivationLabel}"
                                  IsEnabled="{Binding CanTemporarilyActivate}"
                                  ToolTip.Tip="{Binding TemporaryActivationDisabledReason}"
                                  Command="{Binding $parent[UserControl].((feature:FontLibraryViewModel)DataContext).ToggleTemporaryActivationCommand}"
                                  CommandParameter="{Binding .}" />
                          <Button Classes="ghost sm"
                                  Content="{Binding FavoriteLabel}"
                                  Command="{Binding $parent[UserControl].((feature:FontLibraryViewModel)DataContext).ToggleFavoriteCommand}"
                                  CommandParameter="{Binding .}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="{Binding PreviewText}"
                                 FontFamily="{Binding FamilyName}"
                                 FontSize="{Binding PreviewFontSize}"
                                 TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding Tags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="sys:String">
                            <Border Classes="badge" Margin="0,0,7,7">
                              <TextBlock Text="{Binding .}" FontSize="12" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </Grid>
      </Border>

      </Grid>

      <Border x:Name="LibraryDetailsPanel"
              Grid.Column="2"
              Background="{DynamicResource GlyphSurfaceBrush}"
              BorderBrush="{DynamicResource GlyphBorderBrush}"
              BorderThickness="1"
              CornerRadius="{StaticResource GlyphRadiusLg}">
        <views:FontDetailsPanelView />
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource GlyphSurfaceBrush}"
            BorderBrush="{DynamicResource GlyphBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,9">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{DynamicResource L.Text.2897745B51848BD6}" VerticalAlignment="Center" Classes="muted" />
          <TextBox Width="320" MinHeight="30" Text="{Binding PreviewText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{DynamicResource L.Text.F71561B5AF0ABCED}" VerticalAlignment="Center" Classes="muted" />
          <Slider Width="140" Minimum="18" Maximum="48" Value="{Binding PreviewFontSize, Mode=TwoWay}" />
          <TextBlock Text="{Binding PreviewFontSizeLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3" Background="{DynamicResource GlyphModalScrimBrush}" IsVisible="{Binding IsImportDialogOpen}">
      <Border Width="720" MaxHeight="620" Classes="panel" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource L.Text.50751AA95894C7DB}" Classes="h1" />
          <TextBlock Text="{Binding ImportStatus}" Classes="muted" TextWrapping="Wrap" />
          <Border Classes="card">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel>
                <TextBlock Text="{DynamicResource L.Text.1D19B5731BBA7989}" Classes="caption" />
                <TextBlock Text="{Binding ManagedFontDirectory}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ManagedDirectoryStatus}" Classes="muted" />
              </StackPanel>
              <Button Grid.Column="1" Content="{DynamicResource L.Text.E5FE24CA742F83D9}" Command="{Binding ChooseManagedDirectoryCommand}" />
            </Grid>
          </Border>
          <Border Classes="card">
            <ItemsControl ItemsSource="{Binding ImportPreviewItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ImportPreviewItemViewModel">
                  <Grid ColumnDefinitions="1.4*,.5*,1*,1.2*" Margin="0,0,0,8" ColumnSpacing="10">
                    <TextBlock Text="{Binding FileName}" />
                    <TextBlock Grid.Column="1" Text="{Binding Format}" Classes="muted" />
                    <TextBlock Grid.Column="2" Text="{Binding Status}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="3" Text="{Binding LicenseLabel}" Classes="muted" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <UniformGrid Columns="2">
            <CheckBox Content="{DynamicResource L.Text.600F9A76B6C980C0}" IsChecked="True" />
            <CheckBox Content="{DynamicResource L.Text.C05FE82711F59CA0}" IsChecked="{Binding ImportInstallForCurrentUser, Mode=TwoWay}" />
            <CheckBox Content="{DynamicResource L.Text.BC2D06CAB2823593}"
                      IsChecked="{Binding ImportTemporarilyActivate, Mode=TwoWay}"
                      IsEnabled="{Binding CanImportTemporarilyActivate}"
                      ToolTip.Tip="{Binding ImportTemporaryActivationReason}" />
            <TextBox PlaceholderText="{DynamicResource L.Text.E42F26CF19B37382}" Text="{Binding ImportTagsText, Mode=TwoWay}" />
            <TextBox PlaceholderText="{DynamicResource L.Text.730EEF8C85CF25AF}" Text="{Binding ImportCollectionsText, Mode=TwoWay}" />
          </UniformGrid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{DynamicResource L.Text.2CD0F3BE8738A86C}" Command="{Binding CloseImportDialogCommand}" />
            <Button Content="{DynamicResource L.Text.BB8AA0DDAAF3E6D1}" Classes="primary" Command="{Binding StartImportCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.RowSpan="3" Background="{DynamicResource GlyphModalScrimBrush}" IsVisible="{Binding IsTagsDialogOpen}">
      <Border Width="620" Classes="panel" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource L.Text.1D0FD5F9336D9103}" Classes="h1" />
          <TextBlock Text="{DynamicResource L.Text.B693A650B05575B6}" Classes="muted" TextWrapping="Wrap" />
          <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource L.Text.668500F7CE3CE034}" Classes="h2" />
              <Border Classes="card" Padding="10" MaxHeight="180">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding TagOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NameOptionViewModel">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <TextBlock Text="{Binding Name}" />
                              <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="12" />
                            </StackPanel>
                          </CheckBox>
                          <Button Grid.Column="1"
                                  Classes="sm"
                                  Content="{DynamicResource L.Text.2F9DAA828907B93F}"
                                  Command="{Binding $parent[UserControl].((feature:FontLibraryViewModel)DataContext).OpenDeleteTagDialogCommand}"
                                  CommandParameter="{Binding Name}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <TextBox PlaceholderText="{DynamicResource L.Text.EF55978F6C447E0E}" Text="{Binding TagEditorText, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="8">
              <TextBlock Text="{DynamicResource L.Text.46FD1A0256739788}" Classes="h2" />
              <Border Classes="card" Padding="10" MaxHeight="180">
                <ScrollViewer>
                  <ItemsControl ItemsSource="{Binding CollectionOptions}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:NameOptionViewModel">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,6">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Name}" />
                            <TextBlock Text="{Binding CountLabel}" Classes="muted" FontSize="12" />
                          </StackPanel>
                        </CheckBox>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>
              <TextBox PlaceholderText="{DynamicResource L.Text.A9846C09D1F7C307}" Text="{Binding CollectionEditorText, Mode=TwoWay}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{DynamicResource L.Text.FDCCE955B1B40E3A}" Classes="muted" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{DynamicResource L.Text.2CD0F3BE8738A86C}" Command="{Binding CloseTagsDialogCommand}" />
            <Button Content="{DynamicResource L.Text.A3030BF8F16DC63C}" Classes="primary" Command="{Binding SaveTagsDialogCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Background="{DynamicResource GlyphModalScrimBrush}" IsVisible="{Binding IsDeleteTagDialogOpen}">
        <Border Width="460"
                Classes="panel"
                Padding="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <StackPanel Spacing="14">
            <TextBlock Text="{DynamicResource L.Text.2BE218C1EBAC7C05}" Classes="h2" />
            <TextBlock Text="{Binding PendingDeleteTagConfirmationText}" TextWrapping="Wrap" />
            <Border Classes="card subtle-card">
              <TextBlock Text="{DynamicResource L.Text.22960ABEF797BF83}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
              <Button Content="{DynamicResource L.Text.2CD0F3BE8738A86C}" Command="{Binding CloseDeleteTagDialogCommand}" />
              <Button Content="{DynamicResource L.Text.2F9DAA828907B93F}" Classes="danger" Command="{Binding ConfirmDeleteTagCommand}" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
