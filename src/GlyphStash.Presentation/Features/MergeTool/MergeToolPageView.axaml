<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feature="using:GlyphStash.Presentation.Features.MergeTool"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.MergeToolPageView"
             x:DataType="feature:MergeToolViewModel">
  <Grid x:Name="MergeToolRoot" RowDefinitions="76,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource GlyphSurfaceBrush}" BorderBrush="{DynamicResource GlyphBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{DynamicResource L.Text.FB9C0DEF1A9D32FF}" Classes="h1" />
          <TextBlock Text="{DynamicResource L.Text.8348F263AE3707CB}" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource L.Text.B7207659E11A57A1}" Command="{Binding LoadMergeReportCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" RowDefinitions="Auto,*" RowSpacing="16" Margin="{StaticResource GlyphPagePadding}">
      <ItemsControl ItemsSource="{Binding MergeSteps}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="5" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:MergeStepItemViewModel">
            <Button Command="{Binding $parent[UserControl].((feature:MergeToolViewModel)DataContext).SetMergeStepCommand}"
                    CommandParameter="{Binding .}"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Margin="0,0,8,0">
              <Border Classes="merge-step" Classes.active="{Binding IsActive}">
                <TextBlock Text="{Binding Label}" />
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Grid.Row="1" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <Grid RowDefinitions="*,Auto" RowSpacing="16">
          <ScrollViewer>
            <Grid>
              <Grid x:Name="MergeSelectFontsGrid" IsVisible="{Binding IsMergeStepSelectFonts}" RowDefinitions="*" ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="card" Padding="14">
                  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource L.Text.DBF90F3448FFF67E}" Classes="h2" />
                      <Border Grid.Column="1" Classes="badge blue"><TextBlock Text="{DynamicResource L.Text.FA21B588AD431D13}" FontSize="12" /></Border>
                    </Grid>
                    <TextBox Grid.Row="1" Text="{Binding MergeBaseSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource L.Text.F39DAF702768A643}" />
                    <ListBox Grid.Row="2"
                             Classes="font-list"
                             ItemsSource="{Binding MergeBaseFonts}"
                             SelectedItem="{Binding SelectedMergeBaseFont, Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FontFamilyItemViewModel">
                          <Border Classes="card" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                              <TextBlock Text="{Binding FamilyName}" Classes="h2" />
                              <TextBlock Text="{Binding FormatSummary}" Classes="muted" />
                              <WrapPanel>
                                <Border Classes="badge ok" Margin="0,0,7,7"><TextBlock Text="{Binding StateLabel}" FontSize="12" /></Border>
                                <Border Classes="badge" Margin="0,0,7,7"><TextBlock Text="{Binding SourceLabel}" FontSize="12" /></Border>
                                <Border Classes="badge" Margin="0,0,7,7"><TextBlock Text="{Binding LicenseLabel}" FontSize="12" /></Border>
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>

                <Border x:Name="MergeSupplementalPanel" Grid.Column="1" Classes="card" Padding="14">
                  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{DynamicResource L.Text.226670DD58EE6676}" Classes="h2" />
                      <Border Grid.Column="1" Classes="badge warn"><TextBlock Text="{DynamicResource L.Text.AECD817AD798493A}" FontSize="12" /></Border>
                    </Grid>
                    <TextBox Grid.Row="1" Text="{Binding MergeSupplementalSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource L.Text.F39DAF702768A643}" />
                    <ListBox Grid.Row="2"
                             Classes="font-list"
                             ItemsSource="{Binding MergeSupplementalFonts}"
                             SelectedItem="{Binding SelectedMergeSupplementalFont, Mode=TwoWay}">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FontFamilyItemViewModel">
                          <Border Classes="card" Margin="0,0,0,8">
                            <StackPanel Spacing="6">
                              <TextBlock Text="{Binding FamilyName}" Classes="h2" />
                              <TextBlock Text="{Binding FormatSummary}" Classes="muted" />
                              <WrapPanel>
                                <Border Classes="badge ok" Margin="0,0,7,7"><TextBlock Text="{Binding StateLabel}" FontSize="12" /></Border>
                                <Border Classes="badge" Margin="0,0,7,7"><TextBlock Text="{Binding SourceLabel}" FontSize="12" /></Border>
                                <Border Classes="badge" Margin="0,0,7,7"><TextBlock Text="{Binding LicenseLabel}" FontSize="12" /></Border>
                              </WrapPanel>
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </Grid>
                </Border>
              </Grid>

                <StackPanel IsVisible="{Binding IsMergeStepRanges}" Spacing="14">
                  <StackPanel Spacing="7">
                    <TextBlock Text="{DynamicResource L.Text.AEFC7C95051E7E25}" Classes="caption" FontWeight="Bold" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <TextBox Text="{Binding MergeUnicodeRanges, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="U+4E00-U+9FFF, U+3000" />
                      <Button Grid.Column="1" Content="{DynamicResource L.Text.CFB32C4D0454E0D8}" Command="{Binding OpenMergeRangeDialogCommand}" />
                    </Grid>
                  </StackPanel>
                <StackPanel Spacing="7">
                  <TextBlock Text="{DynamicResource L.Text.B43C644EE7186159}" Classes="caption" FontWeight="Bold" />
                  <ComboBox ItemsSource="{Binding MergeModeOptionModels}"
                            SelectedItem="{Binding SelectedMergeModeOptionByValue, Mode=TwoWay}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:LocalizedOptionViewModel">
                        <TextBlock Text="{Binding DisplayName}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Text="{Binding MergeModeDescription}" Classes="muted" TextWrapping="Wrap" />
                </StackPanel>
                <WrapPanel>
                  <Button Content="CJK Unified Ideographs" Classes="sm" Margin="0,0,8,8" Command="{Binding ApplyMergeUnicodeBlockCommand}" CommandParameter="U+4E00-U+9FFF" />
                  <Button Content="Basic Latin" Classes="sm" Margin="0,0,8,8" Command="{Binding ApplyMergeUnicodeBlockCommand}" CommandParameter="U+0000-U+007F" />
                  <Button Content="CJK Symbols" Classes="sm" Margin="0,0,8,8" Command="{Binding ApplyMergeUnicodeBlockCommand}" CommandParameter="U+3000-U+303F" />
                  <Button Content="Punctuation" Classes="sm" Margin="0,0,8,8" Command="{Binding ApplyMergeUnicodeBlockCommand}" CommandParameter="U+2000-U+206F" />
                </WrapPanel>
                <Border Classes="card">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{DynamicResource L.Text.64B95C202EF8B156}" Classes="h2" />
                    <TextBlock Text="{Binding MergePreviewSummary}" Classes="muted" TextWrapping="Wrap" />
                    <TextBlock Text="{DynamicResource L.Text.9DBC3F28E7E13D7C}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsMergeStepPreview}" Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource L.Text.5ED81FF7DD40F0CC}" Classes="h2" />
                  <Border Grid.Column="1" Classes="badge warn"><TextBlock Text="{Binding MergeDefaultStrategy}" FontSize="12" /></Border>
                </Grid>
                <UniformGrid x:Name="MergePreviewMetricsGrid" Columns="4">
                  <Border Classes="card subtle-card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.B4B0B5607F35F091}" Classes="caption" /><TextBlock Text="{Binding MergePreviewSummary}" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Classes="card subtle-card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.8088CC83B2D5B458}" Classes="caption" /><TextBlock Text="{Binding MergeDefaultStrategy}" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Classes="card subtle-card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.6320B4A8722A851F}" Classes="caption" /><TextBlock Text="{Binding MergeStatus}" TextWrapping="Wrap" /></StackPanel></Border>
                  <Border Classes="card subtle-card" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.BFA4F5CA175A609A}" Classes="caption" /><TextBlock Text="{Binding MergeConflicts.Count}" /></StackPanel></Border>
                </UniformGrid>

                <ItemsControl ItemsSource="{Binding MergeIssues}" IsVisible="{Binding HasMergeIssues}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MergeIssueItemViewModel">
                      <Border Classes="card" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                          <Border Classes="badge" Classes.danger="{Binding IsError}" Classes.warn="{Binding IsWarning}" Classes.ok="{Binding IsInfo}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding SeverityLabel}" FontSize="12" />
                          </Border>
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Target}" Classes="muted" IsVisible="{Binding HasTarget}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid RowDefinitions="Auto,*">
                  <Grid ColumnDefinitions="1.1*,0.5*,1*,1*,1*" Margin="0,0,0,8">
                    <TextBlock Text="{DynamicResource L.Text.C6B4E2B9B8A12A08}" Classes="caption" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{DynamicResource L.Text.25DCEBD656BBE8F5}" Classes="caption" FontWeight="Bold" />
                    <TextBlock Grid.Column="2" Text="{DynamicResource L.Text.E9F23D6A6B141DF2}" Classes="caption" FontWeight="Bold" />
                    <TextBlock Grid.Column="3" Text="{DynamicResource L.Text.188F5E35363F3F5B}" Classes="caption" FontWeight="Bold" />
                    <TextBlock Grid.Column="4" Text="{DynamicResource L.Text.A0583ECC011DD3DB}" Classes="caption" FontWeight="Bold" />
                  </Grid>
                  <ItemsControl Grid.Row="1" ItemsSource="{Binding MergeConflicts}" IsVisible="{Binding HasMergeConflicts}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:MergeConflictItemViewModel">
                        <Border Classes="card" Margin="0,0,0,8">
                          <Grid ColumnDefinitions="1.1*,0.5*,1*,1*,1*" ColumnSpacing="10">
                            <TextBlock Text="{Binding UnicodeLabel}" FontFamily="{StaticResource GlyphFontMono}" />
                            <TextBlock Grid.Column="1" Text="{Binding Character}" FontSize="22" />
                            <TextBlock Grid.Column="2" Text="{Binding BaseStateLabel}" />
                            <TextBlock Grid.Column="3" Text="{Binding SupplementalStateLabel}" />
                            <Border Grid.Column="4" Classes="badge" Classes.ok="{Binding IsMerge}" Classes.warn="{Binding IsSkip}" Classes.danger="{Binding IsMissing}" Classes.blue="{Binding IsOverwrite}">
                              <TextBlock Text="{Binding DecisionLabel}" FontSize="12" />
                            </Border>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Grid.Row="1" Text="{DynamicResource L.Text.11E28248C7176DB1}" Classes="muted" HorizontalAlignment="Center" Margin="0,28,0,0" IsVisible="{Binding !HasMergeConflicts}" />
                </Grid>
              </StackPanel>

              <Grid x:Name="MergeExportGrid" IsVisible="{Binding IsMergeStepExport}" RowDefinitions="*" ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border Classes="card" Padding="14">
                  <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource L.Text.EBB69A02038C8733}" Classes="h2" />
                    <TextBlock Text="{DynamicResource L.Text.0431D545006F362B}" Classes="muted" TextWrapping="Wrap" />
                    <WrapPanel>
                      <Border Classes="badge ok" Margin="0,0,7,7"><TextBlock Text="{Binding SelectedMergeBaseFont.LicenseLabel}" FontSize="12" /></Border>
                      <Border Classes="badge warn" Margin="0,0,7,7"><TextBlock Text="{Binding SelectedMergeSupplementalFont.LicenseLabel}" FontSize="12" /></Border>
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding MergeLicenseConfirmed, Mode=TwoWay}" Content="{DynamicResource L.Text.DCF5F1AECFD13EFF}" />
                  </StackPanel>
                </Border>

                <Border x:Name="MergeOutputPanel" Grid.Column="1" Classes="card" Padding="14">
                  <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource L.Text.2C23444AAD233136}" Classes="h2" />
                    <StackPanel Spacing="7">
                      <TextBlock Text="{DynamicResource L.Text.176BC21F083D8FB3}" Classes="caption" FontWeight="Bold" />
                      <TextBox Text="{Binding MergeOutputFontName, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Spacing="7">
                      <TextBlock Text="{DynamicResource L.Text.2EFCDA48D089BB8C}" Classes="caption" FontWeight="Bold" />
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding MergeOutputPath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="{DynamicResource L.Text.C11330B85234F9C0}" Command="{Binding ChooseMergeOutputPathCommand}" />
                      </Grid>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource L.Text.17A851824628B29B}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel IsVisible="{Binding IsMergeStepReport}" Spacing="14">
                <Border Classes="card" Padding="14">
                  <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding MergeReportTitle}" Classes="h2" />
                      <Border Grid.Column="1" Classes="badge ok"><TextBlock Text="{Binding MergeReportBadge}" FontSize="12" /></Border>
                    </Grid>
                    <TextBlock Text="{Binding MergeStatus}" Classes="muted" TextWrapping="Wrap" />
                    <UniformGrid x:Name="MergeReportGrid" Columns="2">
                      <Border Classes="card subtle-card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.5DA217753D171608}" Classes="caption" /><TextBlock Text="{Binding MergeReportInputFonts}" TextWrapping="Wrap" /></StackPanel></Border>
                      <Border Classes="card subtle-card" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.AE72B532F4B8F09E}" Classes="caption" /><TextBlock Text="{Binding MergeReportRangeLabel}" TextWrapping="Wrap" /></StackPanel></Border>
                      <Border Classes="card subtle-card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.F0EE7A0303F51FEB}" Classes="caption" /><TextBlock Text="{Binding MergeReportOutputPath}" TextWrapping="Wrap" /></StackPanel></Border>
                      <Border Classes="card subtle-card" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.4ED91E1B8E6E5171}" Classes="caption" /><TextBlock Text="{Binding MergeReportLicenseTime}" /></StackPanel></Border>
                    </UniformGrid>
                    <Border Classes="card">
                      <StackPanel>
                        <TextBlock Text="{DynamicResource L.Text.89ABE8C6AC131464}" Classes="caption" />
                        <TextBlock Text="{Binding MergeReportStatsLabel}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                    <Border Classes="card" IsVisible="{Binding HasMergeIssues}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource L.Text.B826CA213525C71A}" Classes="h2" />
                        <TextBlock Text="{Binding MergeReportErrorMessage}" Classes="muted" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding MergeIssues}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MergeIssueItemViewModel">
                              <TextBlock Text="{Binding Message}" Classes="muted" TextWrapping="Wrap" Margin="0,0,0,5" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding MergeReportPath}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>

          <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="10">
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding MergeProgressPercent}" IsVisible="{Binding IsMergeBusy}" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
              <Button Content="{DynamicResource L.Text.DA336FDC0DBD1818}" Command="{Binding PreviousMergeStepCommand}" IsEnabled="{Binding CanGoPreviousMergeStep}" />
              <TextBlock Grid.Column="1" Text="{Binding MergeProgressLabel}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="2" Content="{DynamicResource L.Text.2CD0F3BE8738A86C}" Command="{Binding CancelMergeCommand}" IsVisible="{Binding CanCancelMerge}" />
              <Button Grid.Column="3" Content="{Binding MergeNextActionLabel}" Classes="primary" Command="{Binding NextMergeStepCommand}" IsEnabled="{Binding !IsMergeBusy}" />
            </Grid>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource GlyphSurfaceBrush}" BorderBrush="{DynamicResource GlyphBorderBrush}" BorderThickness="0,1,0,0" Padding="24,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource L.Text.B6C759073E1EDB55}" Classes="muted" />
        <TextBlock Grid.Column="1" Text="{Binding MergeDefaultStrategy}" Classes="muted" />
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3" Background="{DynamicResource GlyphModalScrimBrush}" IsVisible="{Binding IsMergeRangeDialogOpen}">
      <Border Width="920" MaxHeight="680" Classes="panel" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.Text.6CF43F6D27943896}" Classes="h1" />
              <TextBlock Text="{DynamicResource L.Text.5A266728E87B0780}" Classes="muted" Margin="0,5,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource L.Text.3FD47EDCE45B3603}" Command="{Binding CloseMergeRangeDialogCommand}" />
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="{DynamicResource L.Text.DBF90F3448FFF67E}" Classes="caption" />
                <TextBlock Text="{Binding MergeRangeBaseSummary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel>
                <TextBlock Text="{DynamicResource L.Text.226670DD58EE6676}" Classes="caption" />
                <TextBlock Text="{Binding MergeRangeSupplementalSummary}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid Grid.Row="2" ColumnDefinitions="280,*" ColumnSpacing="14">
            <Border Classes="card" Padding="12">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <TextBlock Text="{DynamicResource L.Text.62EAE7AEBE5756AC}" Classes="h2" />
                <ListBox Grid.Row="1"
                         Classes="font-list"
                         ItemsSource="{Binding MergeRangeBlocks}"
                         SelectedItem="{Binding SelectedMergeRangeBlock, Mode=TwoWay}"
                         IsVisible="{Binding HasMergeRangeBlocks}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MergeRangeBlockItemViewModel">
                      <Border Classes="card" Margin="0,0,0,8" Padding="10">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" Padding="12">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{DynamicResource L.Text.F881DF9F0C4D9463}" Classes="h2" />
                  <Border Grid.Column="1" Classes="badge">
                    <TextBlock Text="{Binding MergeRangeSelectedCountLabel}" FontSize="12" />
                  </Border>
                </Grid>
                <TextBlock Grid.Row="1" Text="{Binding MergeRangeDialogStatus}" Classes="muted" TextWrapping="Wrap" />
                <TextBlock Grid.Row="2" Text="{DynamicResource L.Text.8E8A908304E172DD}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsMergeRangeDialogBusy}" />
                <TextBlock Grid.Row="2" Text="{DynamicResource L.Text.2BFB6472169B40B1}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding IsMergeRangeEmptyVisible}" />
                <TextBlock Grid.Row="2" Text="{DynamicResource L.Text.ED7DB9D922D2708E}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsMergeRangeBlockEmptyVisible}" />
                <ListBox Grid.Row="2"
                         Classes="font-list"
                         ItemsSource="{Binding MergeRangeSegments}"
                         IsVisible="{Binding HasMergeRangeSegments}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MergeRangeSegmentItemViewModel">
                      <Border Classes="card" Margin="0,0,0,8" Padding="10">
                        <Grid ColumnDefinitions="Auto,1.4*,Auto,Auto,Auto" ColumnSpacing="10">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" />
                          <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="{Binding RangeLabel}" FontFamily="{StaticResource GlyphFontMono}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding BlockName}" Classes="muted" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding SampleLabel}" FontSize="22" VerticalAlignment="Center" />
                          <Border Grid.Column="3" Classes="badge" Classes.warn="{Binding IsBaseOnly}" Classes.ok="{Binding IsSupplementalOnly}" Classes.blue="{Binding IsBoth}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PresenceLabel}" FontSize="12" />
                          </Border>
                          <TextBlock Grid.Column="4" Text="{Binding CountLabel}" Classes="muted" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{DynamicResource L.Text.2CD0F3BE8738A86C}" Command="{Binding CloseMergeRangeDialogCommand}" />
            <Button Content="{DynamicResource L.Text.7F2ADA4C8BA6899B}" Classes="primary" Command="{Binding ApplyMergeRangeSelectionCommand}" IsEnabled="{Binding CanApplyMergeRangeSelection}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
