<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:feature="using:GlyphStash.Presentation.Features.Settings"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.SettingsPageView"
             x:DataType="feature:SettingsViewModel">
  <Grid RowDefinitions="76,*,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource GlyphSurfaceBrush}"
            BorderBrush="{DynamicResource GlyphBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{DynamicResource L.Text.DF3D58C7D84B85F2}" Classes="h1" />
          <TextBlock Text="{DynamicResource L.Text.5935AECA04C45D7B}" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource L.Text.58FBE43DC5FA02FE}" Classes="primary" Command="{Binding ChooseManagedDirectoryCommand}" />
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="{StaticResource GlyphPagePadding}" Spacing="16">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
          <Border Grid.Column="0" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.Text.0AF5B0C22604E63B}" Classes="h2" />
                <Border Grid.Column="1" Classes="badge ok"><TextBlock Text="{Binding ManagedDirectoryStatus}" FontSize="12" /></Border>
              </Grid>
              <TextBlock Text="{Binding ManagedFontDirectory}" TextWrapping="Wrap" />
              <TextBlock Text="{DynamicResource L.Text.0FDD3B634A219DC5}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
            <StackPanel Spacing="12">
              <TextBlock Text="{DynamicResource L.Text.EE42D5CDB0340DAF}" Classes="h2" />
              <WrapPanel>
                <Border Classes="badge ok" Margin="0,0,7,7"><TextBlock Text="TTF" /></Border>
                <Border Classes="badge ok" Margin="0,0,7,7"><TextBlock Text="OTF" /></Border>
                <Border Classes="badge ok" Margin="0,0,7,7"><TextBlock Text="TTC" /></Border>
                <Border Classes="badge ok" Margin="0,0,7,7"><TextBlock Text="OTC" /></Border>
                <Border Classes="badge warn" Margin="0,0,7,7"><TextBlock Text="{DynamicResource L.Text.212BF7E284C07D5B}" /></Border>
              </WrapPanel>
              <TextBlock Text="{DynamicResource L.Text.28944036E53ECC33}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{DynamicResource L.Text.AAADBE1072940984}" Classes="h2" />
                <Border Grid.Column="1" Classes="badge warn"><TextBlock Text="{Binding GoogleFontsApiKeyStatus}" FontSize="12" /></Border>
              </Grid>
              <TextBlock Text="{DynamicResource L.Text.6C0E01EED4D4DFB3}" Classes="muted" TextWrapping="Wrap" />
              <TextBox PasswordChar="*" PlaceholderText="Google Fonts API key" Text="{Binding GoogleFontsApiKeyText, Mode=TwoWay}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{DynamicResource L.Text.53BC5404459457AB}" Classes="primary" Command="{Binding SaveGoogleFontsApiKeyCommand}" VerticalAlignment="Bottom" />
          </Grid>
        </Border>

        <Border Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="10">
                <TextBlock Text="{DynamicResource L.Text.64C230D2256744E6}" Classes="h2" />
                <TextBlock Text="{Binding AppUpdateStatus}" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      Content="{DynamicResource L.Text.7F68EBAD19BA6BCD}"
                      Classes="primary"
                      Command="{Binding CheckForAppUpdatesCommand}"
                      IsEnabled="{Binding !IsAppUpdateBusy}"
                      VerticalAlignment="Top" />
            </Grid>

            <UniformGrid Columns="2">
              <Border Classes="card subtle-card" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L.Text.837BC95767211631}" Classes="caption" />
                  <TextBlock Text="{Binding AppUpdateCurrentVersion}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Border Classes="card subtle-card">
                <StackPanel>
                  <TextBlock Text="{DynamicResource L.Text.73299101ABB72E75}" Classes="caption" />
                  <TextBlock Text="{Binding AppUpdateSource}" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border Classes="card" IsVisible="{Binding CanDownloadAppUpdate}">
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding AppUpdateAvailableVersion}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding AppUpdateReleaseNotes}" TextWrapping="Wrap" MaxHeight="120" IsVisible="{Binding HasAppUpdateReleaseNotes}" />
                <TextBlock Text="{Binding AppUpdateProgressLabel}" Classes="muted" IsVisible="{Binding IsAppUpdateBusy}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding AppUpdateProgress}" IsVisible="{Binding IsAppUpdateBusy}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                  <Button Content="{DynamicResource L.Text.9D2CA261281A158A}" Command="{Binding DismissAppUpdateCommand}" IsEnabled="{Binding !IsAppUpdateBusy}" />
                  <Button Content="{DynamicResource L.Text.8EAAEC4C18D65C3A}" Classes="primary" Command="{Binding DownloadAndRestartAppUpdateCommand}" IsEnabled="{Binding CanDownloadAppUpdate}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
          <Grid ColumnDefinitions="*,240" ColumnSpacing="16">
            <StackPanel Spacing="10">
              <TextBlock Text="{DynamicResource L.Settings.Language}" Classes="h2" />
              <TextBlock Text="{DynamicResource L.Settings.LanguageDescription}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:LanguageOptionViewModel">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </Grid>
        </Border>

        <Border Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource L.Text.A653344F063233CE}" Classes="h2" />
            <ItemsControl ItemsSource="{Binding CompatibilityMatrix}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sys:String">
                  <Border Classes="card" Margin="0,0,0,8">
                    <TextBlock Text="{Binding .}" TextWrapping="Wrap" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
          <StackPanel Spacing="12">
            <TextBlock Text="{DynamicResource L.Text.BB1D19B85634606E}" Classes="h2" />
            <ItemsControl ItemsSource="{Binding OperationLogs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OperationLogItemViewModel">
                  <Grid ColumnDefinitions="60,90,*,70" Margin="0,0,0,8" ColumnSpacing="10">
                    <TextBlock Text="{Binding TimeLabel}" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="{Binding Category}" />
                    <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="3" Text="{Binding StateLabel}" Classes="muted" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{DynamicResource GlyphSurfaceBrush}"
            BorderBrush="{DynamicResource GlyphBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,9">
      <TextBlock Text="{DynamicResource L.Text.6BB0F905838DFE4F}" Classes="muted" />
    </Border>
  </Grid>
</UserControl>
