<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.FontDetailsPanelView"
             x:DataType="vm:ShellViewModel">
  <Grid>
    <Border Padding="18" IsVisible="{Binding HasNoSelectedFont}">
      <StackPanel Spacing="12" VerticalAlignment="Center">
        <TextBlock Text="{DynamicResource L.Text.942396D281D2FC31}" Classes="h1" />
        <TextBlock Text="{DynamicResource L.Text.9BAC7A3011E93826}" Classes="muted" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <ScrollViewer IsVisible="{Binding HasSelectedFont}">
      <StackPanel Spacing="16" Margin="18">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding SelectedFont.FamilyName}" Classes="h1" />
              <WrapPanel Margin="0,8,0,0">
                <Border Classes="badge" Margin="0,0,7,0"><TextBlock Text="{Binding SelectedFont.SourceLabel}" FontSize="12" /></Border>
                <Border Classes="badge ok" Margin="0,0,7,0"><TextBlock Text="{Binding SelectedFont.StateLabel}" FontSize="12" /></Border>
              </WrapPanel>
            </StackPanel>
            <Button Grid.Column="1" Classes="sm" Content="{Binding SelectedFont.FavoriteLabel}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedFont}" />
          </Grid>
          <TextBlock Text="{Binding PreviewText}"
                     FontFamily="{Binding SelectedPreviewFontFamily}"
                     FontWeight="{Binding SelectedPreviewFontWeight}"
                     FontStyle="{Binding SelectedPreviewFontStyle}"
                     FontSize="{Binding PreviewFontSize}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="10">
          <TextBlock Text="{DynamicResource L.Text.6A3219761890E001}" Classes="h2" />
          <WrapPanel>
            <Button Content="{Binding SelectedFont.TemporaryActivationLabel}" Classes="primary sm" Command="{Binding ToggleTemporaryActivationCommand}" CommandParameter="{Binding SelectedFont}" IsEnabled="{Binding SelectedFont.CanTemporarilyActivate}" ToolTip.Tip="{Binding SelectedFont.TemporaryActivationDisabledReason}" Margin="0,0,8,8" />
            <Button Content="{Binding SelectedFont.InstallLabel}" Classes="sm" Command="{Binding InstallSelectedFontCommand}" Margin="0,0,8,8" />
            <Button Content="{DynamicResource L.Text.1B1FC8BE9CBCD0D9}" Classes="danger sm" Command="{Binding OpenUninstallDialogCommand}" Margin="0,0,8,8" />
            <Button Content="{DynamicResource L.Text.F50E59DDA0377D03}" Classes="sm" Command="{Binding OpenGlyphBrowserCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock Text="{DynamicResource L.Text.26BD3ECBF8795177}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource L.Text.15A81B9294C7CEFE}" Classes="h2" />
            <Border Grid.Column="1" Classes="badge warn">
              <TextBlock Text="{Binding SelectedFont.LicenseLabel}" FontSize="12" />
            </Border>
          </Grid>
          <UniformGrid Columns="2" Rows="3">
            <Border Classes="card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.C8FFBDF15754D1D2}" Classes="caption" /><TextBlock Text="{Binding SelectedFont.StyleCountLabel}" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.0E8B1C78C5F335BA}" Classes="caption" /><TextBlock Text="{Binding SelectedFont.FormatSummary}" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.5F76B2BF82DD2C5D}" Classes="caption" /><TextBlock Text="{Binding SelectedFont.VersionLabel}" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.BA6117467E72C391}" Classes="caption" /><TextBlock Text="{Binding SelectedFont.ManufacturerLabel}" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource L.Text.4CE4C98EB27E4B65}" Classes="caption" /><TextBlock Text="{Binding SelectedFont.CoverageLabel}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock Text="{DynamicResource L.Text.79CF2E84EC2FF518}" Classes="caption" /><TextBlock Text="{Binding SelectedFont.HashLabel}" TextWrapping="Wrap" /></StackPanel></Border>
          </UniformGrid>
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.Text.C71200B5952E3781}" Classes="caption" />
              <TextBlock Text="{Binding SelectedFont.FilePath}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource L.Text.91A7B81E0C7B7979}" Classes="h2" />
            <Button Grid.Column="1" Classes="sm" Content="{DynamicResource L.Text.BFFA882506783B57}" Command="{Binding OpenTagsDialogCommand}" />
          </Grid>
          <ListBox ItemsSource="{Binding SelectedFont.Faces}" SelectedItem="{Binding SelectedPreviewFace, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FontFaceItemViewModel">
                <Border Classes="card" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding StyleLabel}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding PostScriptName}" Classes="muted" />
                      <TextBlock Text="{Binding FilePath}" Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="badge ok" VerticalAlignment="Center" IsVisible="{Binding IsSelected}">
                      <TextBlock Text="{DynamicResource L.Text.86C0EC198215F318}" FontSize="12" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Grid Background="{DynamicResource GlyphModalScrimBrush}" IsVisible="{Binding IsUninstallDialogOpen}">
      <Border Width="520" Classes="panel" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource L.Text.B37E13875DF8EBC0}" Classes="h1" />
          <TextBlock Text="{DynamicResource L.Text.B73A6046290FE0B0}" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{DynamicResource L.Text.2CD0F3BE8738A86C}" Command="{Binding CloseUninstallDialogCommand}" />
            <Button Content="{DynamicResource L.Text.4FEC200AC3F7FC85}" Classes="danger" Command="{Binding ConfirmUninstallCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
