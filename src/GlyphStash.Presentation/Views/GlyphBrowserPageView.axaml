<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.GlyphBrowserPageView"
             x:DataType="vm:ShellViewModel">
  <Grid RowDefinitions="76,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource GlyphSurfaceBrush}" BorderBrush="{DynamicResource GlyphBorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{Binding GlyphBrowserTitle}" Classes="h1" />
          <TextBlock Text="{Binding GlyphBrowserDescription}" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Content="{DynamicResource L.Text.03FC34F674A4C5A3}" Command="{Binding BackFromGlyphBrowserCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="260,*,340" ColumnSpacing="16" Margin="{StaticResource GlyphPagePadding}">
      <Border Grid.Column="0" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="7">
            <TextBlock Text="{DynamicResource L.Text.53A1A9CD998CC556}" Classes="caption" FontWeight="Bold" />
            <TextBox Text="{Binding GlyphSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource L.Text.3EE1A4ADA71C5604}" />
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Text="{DynamicResource L.Text.62EAE7AEBE5756AC}" Classes="caption" FontWeight="Bold" />
            <ComboBox ItemsSource="{Binding UnicodeBlocks}" SelectedItem="{Binding SelectedUnicodeBlock}" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Text="{DynamicResource L.Text.9CB5550B9A4D1AD1}" Classes="caption" FontWeight="Bold" />
            <ComboBox SelectedIndex="0" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="{DynamicResource L.Text.6630CF85D6A25200}" />
              <ComboBoxItem Content="{DynamicResource L.Text.007609C08F436C5F}" IsEnabled="False" />
            </ComboBox>
          </StackPanel>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="{DynamicResource L.Text.41299D9BE86670E7}" Classes="h2" />
              <TextBlock Text="{Binding GlyphPageLabel}" FontWeight="SemiBold" />
              <TextBlock Text="{DynamicResource L.Text.CC1781207BA5C4B1}" Classes="muted" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{DynamicResource L.Text.C9B9AE7A61444AB7}" Classes="sm" Command="{Binding PreviousGlyphPageCommand}" />
                <Button Content="{DynamicResource L.Text.8A8542F6964852DC}" Classes="sm" Command="{Binding NextGlyphPageCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding GlyphStatus}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Grid.Column="1" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <Grid RowDefinitions="Auto,*">
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Text="{DynamicResource L.Text.D184B34237E85A19}" Classes="h2" />
            <Border Grid.Column="1" Classes="badge"><TextBlock Text="{DynamicResource L.Text.BEB41A62F4538C8C}" FontSize="12" /></Border>
          </Grid>
          <TextBlock Grid.Row="1" Text="{Binding GlyphStatus}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasGlyphs}" />
          <ListBox Grid.Row="1" Classes="font-list" ItemsSource="{Binding Glyphs}" SelectedItem="{Binding SelectedGlyph, Mode=TwoWay}" IsVisible="{Binding HasGlyphs}">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:GlyphItemViewModel">
                <Border Width="78" Height="82" Classes="card" Margin="0,0,8,8" Padding="5">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding Character}" FontSize="28" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding UnicodeLabel}" Classes="caption" HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="panel" Padding="18">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource L.Text.F9CEFC6B46BE14BB}" Classes="h1" />
          <TextBlock Text="{Binding SelectedGlyph.Character}" FontSize="76" HorizontalAlignment="Center" />
          <UniformGrid Columns="2">
            <Border Classes="card" Margin="0,0,8,8"><StackPanel><TextBlock Text="Unicode" Classes="caption" /><TextBlock Text="{Binding SelectedGlyph.UnicodeLabel}" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,0,8"><StackPanel><TextBlock Text="Glyph name" Classes="caption" /><TextBlock Text="{Binding SelectedGlyph.GlyphName}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Classes="card" Margin="0,0,8,0"><StackPanel><TextBlock Text="Glyph ID" Classes="caption" /><TextBlock Text="{Binding SelectedGlyph.GlyphIdLabel}" /></StackPanel></Border>
            <Border Classes="card"><StackPanel><TextBlock Text="{DynamicResource L.Text.7F70788BAED78C9E}" Classes="caption" /><TextBlock Text="{Binding SelectedGlyph.FaceName}" /></StackPanel></Border>
          </UniformGrid>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="{DynamicResource L.Text.035C96C316D0211B}" Classes="primary" Command="{Binding CopySelectedGlyphCharacterCommand}" />
            <Button Content="{DynamicResource L.Text.7535A31A55ED4248}" Command="{Binding CopySelectedGlyphUnicodeCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource GlyphSurfaceBrush}" BorderBrush="{DynamicResource GlyphBorderBrush}" BorderThickness="0,1,0,0" Padding="24,9">
      <TextBlock Text="{DynamicResource L.Text.CA107E8EA2098299}" Classes="muted" />
    </Border>
  </Grid>
</UserControl>
