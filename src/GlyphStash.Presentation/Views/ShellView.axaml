<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:GlyphStash.Presentation.Views"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             Background="{DynamicResource GlyphBackgroundBrush}">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:FontLibraryViewModel}">
      <views:FontLibraryPageView DataContext="{Binding Shell}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:CollectionsViewModel}">
      <views:CollectionsPageView DataContext="{Binding Shell}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:OnlineFontsViewModel}">
      <views:OnlineFontsPageView DataContext="{Binding Shell}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MergeToolViewModel}">
      <views:MergeToolPageView DataContext="{Binding Shell}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:GlyphBrowserViewModel}">
      <views:GlyphBrowserPageView DataContext="{Binding Shell}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsPageView DataContext="{Binding Shell}" />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:PlaceholderPageViewModel}">
      <views:PlaceholderPageView DataContext="{Binding Shell}" />
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid x:Name="ShellRoot" ColumnDefinitions="244,*">
    <Border x:Name="SidebarRail"
            Grid.Column="0"
            Background="{DynamicResource GlyphSurfaceMutedBrush}"
            BorderBrush="{DynamicResource GlyphBorderBrush}"
            BorderThickness="0,0,1,0"
            Padding="14,18">
      <StackPanel Spacing="18">
        <StackPanel Orientation="Horizontal" Spacing="11" Margin="10,8,10,10">
          <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource GlyphAccentBrush}">
            <TextBlock Text="G" Foreground="White" FontFamily="Georgia" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel>
            <TextBlock Text="GlyphStash" FontWeight="SemiBold" FontSize="16" />
            <TextBlock Text="{DynamicResource L.Text.49693B4032241498}" Classes="caption" />
          </StackPanel>
        </StackPanel>

        <StackPanel Spacing="5">
          <TextBlock Text="MAIN" Classes="caption" Margin="12,0,0,5" FontWeight="Bold" />
          <ListBox Classes="nav-list"
                   ItemsSource="{Binding NavigationItems}"
                   SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:NavigationItemViewModel">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse Width="9" Height="9" Fill="{DynamicResource GlyphAccentBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </StackPanel>
    </Border>

    <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />

    <Border Grid.ColumnSpan="2"
            Classes="panel"
            Background="{DynamicResource GlyphTextBrush}"
            Padding="14,12"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="18"
            IsVisible="{Binding IsToastVisible}">
      <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource GlyphSurfaceBrush}" />
    </Border>
  </Grid>
</UserControl>
