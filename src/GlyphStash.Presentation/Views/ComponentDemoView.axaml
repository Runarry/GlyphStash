<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.ComponentDemoView"
             x:DataType="vm:ShellViewModel">
  <ScrollViewer Background="{DynamicResource GlyphBackgroundBrush}">
    <StackPanel Margin="{StaticResource GlyphPagePadding}" Spacing="16">
      <TextBlock Text="{DynamicResource L.Text.AA11006B0C9ABE4B}" Classes="h1" />
      <Border Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <StackPanel Spacing="12">
          <TextBlock Text="Buttons / Badges / States" Classes="h2" />
          <WrapPanel>
            <Button Content="{DynamicResource L.Text.248BE9E13B46A3ED}" Margin="0,0,8,8" />
            <Button Content="{DynamicResource L.Text.1A3065F0F33AC8DA}" Classes="primary" Margin="0,0,8,8" />
            <Button Content="{DynamicResource L.Text.CD84121ACB17F42D}" Classes="danger" Margin="0,0,8,8" />
            <Border Classes="badge ok" Margin="0,0,8,8"><TextBlock Text="{DynamicResource L.Text.A8B6C39DCABFC14B}" /></Border>
            <Border Classes="badge blue" Margin="0,0,8,8"><TextBlock Text="{DynamicResource L.Text.96A2A0BC3CF68015}" /></Border>
            <Border Classes="badge warn" Margin="0,0,8,8"><TextBlock Text="{DynamicResource L.Text.BC3F968F53642385}" /></Border>
            <Border Classes="badge danger" Margin="0,0,8,8"><TextBlock Text="{DynamicResource L.Text.D0A22BFFA0CE786B}" /></Border>
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <StackPanel Spacing="12">
          <TextBlock Text="Empty / Error / Permission" Classes="h2" />
          <TextBlock Text="{DynamicResource L.Text.FE41F8CD11FB8811}" Classes="muted" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
