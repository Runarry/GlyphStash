<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GlyphStash.Presentation.ViewModels"
             x:Class="GlyphStash.Presentation.Views.CollectionsPageView"
             x:DataType="vm:ShellViewModel">
  <Grid x:Name="CollectionsRoot" RowDefinitions="76,*,Auto">
    <Border Grid.Row="0"
            Background="{DynamicResource GlyphSurfaceBrush}"
            BorderBrush="{DynamicResource GlyphBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="24,0">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="{DynamicResource L.Text.528E5174C2D4E5C8}" Classes="h1" />
          <TextBlock Text="{DynamicResource L.Text.40EC71DB2F483B6C}" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
          <TextBox Width="190" PlaceholderText="{DynamicResource L.Text.ED8D34385552DEE2}" Text="{Binding NewCollectionName, Mode=TwoWay}" />
          <Button Content="{DynamicResource L.Text.BED62355F623E33A}" Classes="primary" Command="{Binding CreateCollectionCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="CollectionsContentGrid" Grid.Row="1" RowDefinitions="*" ColumnDefinitions="280,*,320" ColumnSpacing="16" Margin="{StaticResource GlyphPagePadding}">
      <Border x:Name="CollectionsListPanel" Grid.Column="0" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <StackPanel Spacing="14">
          <StackPanel Spacing="7">
            <TextBlock Text="{DynamicResource L.Text.ACEBDAD2FDF3D37B}" Classes="caption" FontWeight="Bold" />
            <TextBox Text="{Binding CollectionSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{DynamicResource L.Text.43B4AFBB5CD68689}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding Collections}"
                   SelectedItem="{Binding SelectedCollection, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CollectionItemViewModel">
                <Border Classes="card" Margin="0,0,0,8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Name}" Classes="h2" />
                    <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <Border x:Name="CollectionFontsPanel" Grid.Column="1" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <Grid RowDefinitions="Auto,Auto,*">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding SelectedCollection.Name}" Classes="h1" />
              <TextBlock Text="{Binding SelectedCollection.Summary}" Classes="muted" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button Content="{DynamicResource L.Text.F16E2D731614379B}" Classes="primary sm" Command="{Binding ActivateSelectedCollectionCommand}" />
              <Button Content="{DynamicResource L.Text.2E8456BB7D65651A}" Classes="sm" Command="{Binding DeactivateSelectedCollectionCommand}" />
              <Button Content="{DynamicResource L.Text.0555B5CBB85D84C8}" Classes="sm" Command="{Binding ExportSelectedCollectionCommand}" />
              <Button Content="{DynamicResource L.Text.E6A0ED4B53A8AA07}"
                      Classes="danger sm"
                      IsEnabled="{Binding HasSelectedCollection}"
                      Command="{Binding OpenDeleteCollectionDialogCommand}" />
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="1"
                     Text="{DynamicResource L.Text.97A013430F4951F8}"
                     Classes="muted"
                     Margin="0,10,0,12"
                     TextWrapping="Wrap" />
          <ScrollViewer Grid.Row="2">
            <ItemsControl ItemsSource="{Binding CollectionFonts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:FontFamilyItemViewModel">
                  <Border Classes="card" Margin="0,0,0,8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <StackPanel>
                        <TextBlock Text="{Binding FamilyName}" Classes="h2" />
                        <WrapPanel Margin="0,7,0,0">
                          <Border Classes="badge ok" Margin="0,0,7,0"><TextBlock Text="{Binding StateLabel}" FontSize="12" /></Border>
                          <Border Classes="badge" Margin="0,0,7,0"><TextBlock Text="{Binding SourceLabel}" FontSize="12" /></Border>
                          <Border Classes="badge" Margin="0,0,7,0"><TextBlock Text="{Binding LicenseLabel}" FontSize="12" /></Border>
                        </WrapPanel>
                      </StackPanel>
                      <Button Grid.Column="1"
                              Content="{DynamicResource L.Text.6135D4159E892541}"
                              Classes="sm"
                              Command="{Binding $parent[UserControl].((vm:ShellViewModel)DataContext).RemoveFontFromCollectionCommand}"
                              CommandParameter="{Binding .}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <Border x:Name="CollectionDetailPanel" Grid.Column="2" Classes="panel" Padding="{StaticResource GlyphPanelPadding}">
        <ScrollViewer>
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource L.Text.53B9A21A334EAB03}" Classes="h1" />
          <TextBlock Text="{DynamicResource L.Text.62039847115EE30E}" Classes="muted" TextWrapping="Wrap" />
          <UniformGrid x:Name="CollectionMetadataGrid" Columns="2">
            <Border Classes="card subtle-card" Margin="0,0,8,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.BAB73DD2F8B2015D}" Classes="caption" /><TextBlock Text="{Binding SelectedCollection.FontCount}" /></StackPanel></Border>
            <Border Classes="card subtle-card" Margin="0,0,0,8"><StackPanel><TextBlock Text="{DynamicResource L.Text.BC3F968F53642385}" Classes="caption" /><TextBlock Text="{Binding SelectedCollection.UnknownLicenseLabel}" /></StackPanel></Border>
            <Border Classes="card subtle-card" Margin="0,0,8,0"><StackPanel><TextBlock Text="{DynamicResource L.Text.9C2943546C58493C}" Classes="caption" /><TextBlock Text="{Binding SelectedCollection.LastExportedLabel}" /></StackPanel></Border>
            <Border Classes="card subtle-card"><StackPanel><TextBlock Text="{DynamicResource L.Text.9800A458C16B9A02}" Classes="caption" /><TextBlock Text="{DynamicResource L.Text.59D857994F8F0067}" /></StackPanel></Border>
          </UniformGrid>
          <Border Classes="card">
            <StackPanel>
              <TextBlock Text="{DynamicResource L.Text.6A8A485165BCDCCF}" Classes="h2" />
              <TextBlock Text="{DynamicResource L.Text.9F2F01BABD8BAA3C}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2"
            Background="{DynamicResource GlyphSurfaceBrush}"
            BorderBrush="{DynamicResource GlyphBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="24,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{DynamicResource L.Text.A08A61A4ABF4AB2D}" Classes="muted" />
        <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Classes="muted" />
      </Grid>
    </Border>

    <Grid Grid.RowSpan="3" Background="{DynamicResource GlyphModalScrimBrush}" IsVisible="{Binding IsDeleteCollectionDialogOpen}">
      <Border Width="460" Classes="panel" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14">
          <TextBlock Text="{DynamicResource L.Text.E6A0ED4B53A8AA07}" Classes="h1" />
          <TextBlock Text="{Binding SelectedCollection.Name}" Classes="h2" />
          <TextBlock Text="{DynamicResource L.Text.6062F656E61A079A}" Classes="muted" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Content="{DynamicResource L.Text.2CD0F3BE8738A86C}" Command="{Binding CloseDeleteCollectionDialogCommand}" />
            <Button Content="{DynamicResource L.Text.A3EA3C17B401BD2F}" Classes="danger" Command="{Binding ConfirmDeleteCollectionCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
